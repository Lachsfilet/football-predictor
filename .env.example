# ============================================================
# Football Predictor Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Database (SQLite by default - no server needed)
DATABASE_URL=sqlite:///./data/football.db

# Optional: PostgreSQL (uncomment to use instead of SQLite)
# DATABASE_URL=postgresql://user:password@localhost:5432/football_predictor

# Football-Data.org API (free tier - register at football-data.org)
FOOTBALL_DATA_API_KEY=your_api_key_here

# Application settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Data update schedule (cron expression - default: 3 AM daily)
UPDATE_SCHEDULE=0 3 * * *

# Leagues to track (comma-separated football-data.org competition codes)
# PL=Premier League, PD=La Liga, BL1=Bundesliga, SA=Serie A, FL1=Ligue 1
TRACKED_LEAGUES=PL,PD,BL1,SA,FL1

# Scraping settings
SCRAPE_DELAY_SECONDS=3
REQUEST_TIMEOUT_SECONDS=30
